        # Server "@SLUG@"
        location = /s/@SLUG@ {
            return 301 $http_x_ingress_path/s/@SLUG@/;
        }
        location /s/@SLUG@/ {
            set $jd_upstream "@UPSTREAM@";
            rewrite ^/s/@SLUG@(/.*)$ $1 break;
            proxy_pass $jd_upstream;

            proxy_set_header Host $proxy_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $jd_connection;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $jd_proto;
            proxy_set_header X-Forwarded-Prefix "$http_x_ingress_path/s/@SLUG@";
            # Passed as received from the Supervisor; empty values are not sent.
            proxy_set_header X-Remote-User-Id $http_x_remote_user_id;
            proxy_set_header X-Remote-User-Name $http_x_remote_user_name;
            proxy_set_header X-Remote-User-Display-Name $http_x_remote_user_display_name;
            # Sets X-Jam-Dash-Proxy for this server (replacing anything a client sent).
            include @KEY_FILE@;
        }

