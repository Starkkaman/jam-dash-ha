# Rendered by render.sh at start-up. Placeholders: @RUN_DIR@ @RESOLVER@ @UPSTREAM@ @KEY_FILE@
worker_processes 1;
pid @RUN_DIR@/nginx.pid;
error_log /dev/stderr warn;
daemon off;

events {
    worker_connections 1024;
}

http {
    # Never log request headers: the proxy key lives in one, and this format has none of them.
    log_format jam_dash '$remote_addr user="$http_x_remote_user_name" "$request_method $uri" '
                        '$status $body_bytes_sent ${request_time}s';
    access_log /dev/stdout jam_dash;

    server_tokens off;
    client_body_temp_path @RUN_DIR@/client_body;
    proxy_temp_path       @RUN_DIR@/proxy;
    fastcgi_temp_path     @RUN_DIR@/fastcgi;
    uwsgi_temp_path       @RUN_DIR@/uwsgi;
    scgi_temp_path        @RUN_DIR@/scgi;

    # Resolve the Jam-Dash host lazily, so the add-on starts even when Jam-Dash is down.
    resolver @RESOLVER@ valid=30s;
    resolver_timeout 5s;

    map $http_upgrade $jd_connection {
        default upgrade;
        ""      "";
    }
    map $http_x_forwarded_proto $jd_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    server {
        listen 8099 default_server;

        # Only the Supervisor ingress gateway may talk to this add-on.
        allow 172.30.32.2;
        deny  all;

        client_max_body_size 0;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        send_timeout 3600s;
        proxy_ssl_server_name on;

        location / {
            set $jd_upstream "@UPSTREAM@";
            proxy_pass $jd_upstream;

            proxy_set_header Host $proxy_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $jd_connection;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $jd_proto;
            proxy_set_header X-Forwarded-Prefix $http_x_ingress_path;
            # Passed as received from the Supervisor; empty values are not sent.
            proxy_set_header X-Remote-User-Id $http_x_remote_user_id;
            proxy_set_header X-Remote-User-Name $http_x_remote_user_name;
            proxy_set_header X-Remote-User-Display-Name $http_x_remote_user_display_name;
            # Sets X-Jam-Dash-Proxy (replacing anything a client sent).
            include @KEY_FILE@;
        }
    }
}
